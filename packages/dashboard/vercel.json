{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/crypto", "schedule": "*/1 * * * *" },
    { "path": "/api/cron/polymarket", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/stocks", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/strategist", "schedule": "0 6 * * *" },
    { "path": "/api/cron/monitor", "schedule": "*/2 * * * *" }
  ]
}
